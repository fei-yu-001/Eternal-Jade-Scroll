  "scope": "only home/livelihood excerpt; no future scenes copied",
  "panels": [
    {
      "scene": "home",
      "index": 5,
      "art": "home-coming-of-age",
      "speaker": "阿娘",
      "text": "今日十八。阿娘用热鸡蛋在你额上轻轻滚了一圈，盼把病痛和灾厄都滚远些。",
      "focusX": 0.5,
      "focusY": 0.58,
      "zoom": 0.98,
      "dialog": "滚过了，往后的路，平平安安。",
      "balloon": "left",
      "balloonY": 500
    },
    {
      "scene": "livelihood",
      "index": 2,
      "art": "livelihood-forge",
      "speaker": "铁匠",
      "text": "风箱拉得肩膀发酸，师傅让你沉住腰再落锤。收工前，他把磨刀石推过来。",
      "focusX": 0.5,
      "focusY": 0.58,
      "zoom": 0.86,
      "dialog": "刀口留三分厚。干活的家伙，结实才顶用。",
      "balloon": "right",
      "balloonY": 440
    },
    {
      "scene": "livelihood",
      "index": 3,
      "art": "livelihood-herbs",
      "speaker": "药铺",
      "text": "踩碾槽，捣药泥。你把当归、透骨草分好，药老又从锅底捞出一包药渣。",
      "focusX": 0.5,
      "focusY": 0.58,
      "zoom": 0.98,
      "dialog": "拿回去，加些烧酒热敷。凉了就换，别烫着你爹。",
      "balloon": "right",
      "balloonY": 440
    },
    {
      "scene": "livelihood",
      "index": 7,
      "art": "livelihood-father-care",
      "speaker": "暮色归家",
      "text": "药渣和烧酒裹在布里，热气慢慢透进爹的膝头。他攥了半天的手，终于松开一点。",
      "focusX": 0.5,
      "focusY": 0.5,
      "zoom": 0.98
    }
  ],
