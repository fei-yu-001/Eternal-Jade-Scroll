<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- 与 SaveChecks 同一处置：dotnet SDK 10.0.400 起缺少剪裁包数据时报错 NETSDK1226 -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <!-- 与 SaveChecks 同一处置：源文件是 UTF-8 无 BOM，不钉代码页会把中文注解读成乱码 -->
    <CodePage>65001</CodePage>
    <AssemblyName>PuppetRigChecks</AssemblyName>
    <RootNamespace>TwelveJade.Checks</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- W-A/W-C 的数学与 DSP 层是**纯 C#**（不引 UnityEngine），所以能在这里被真的跑起来断言。
         只纳这几个文件：Presentation 目录里其余文件都依赖 UnityEngine
         （PuppetMeshGraphic / FrontEndFootsteps / FrontEndWorld …）。 -->
    <Compile Include="../../GameClient/TwelveJade/Assets/Scripts/Presentation/PuppetRig.cs" Link="Presentation/PuppetRig.cs" />
    <Compile Include="../../GameClient/TwelveJade/Assets/Scripts/Presentation/PuppetGait.cs" Link="Presentation/PuppetGait.cs" />
    <Compile Include="../../GameClient/TwelveJade/Assets/Scripts/Presentation/FootstepSynth.cs" Link="Presentation/FootstepSynth.cs" />
  </ItemGroup>
</Project>
