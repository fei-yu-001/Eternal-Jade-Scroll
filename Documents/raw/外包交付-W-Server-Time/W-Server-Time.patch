 {"code":0,"message":"成功","data":{"slots":[
-  {"slot":1,"present":true,"updatedAt":"2026-10-04T01:30:57.908464"},
+  {"slot":1,"present":true,"updatedAt":"2026-10-05T09:32:19.123456Z"},
